<!DOCTYPE html>
<html>

<head>
    <title>Edit Student</title>
</head>


<body>


<h1>Edit Student</h1>


<form 
    action="/students/<%= student.id %>?_method=PUT"
    method="POST">


    <label>
        Name:
    </label>

    <input 
        type="text"
        name="name"
        value="<%= student.name %>"
        required>

    <br><br>



    <label>
        Email:
    </label>

    <input 
        type="email"
        name="email"
        value="<%= student.email %>"
        required>

    <br><br>



    <label>
        Course:
    </label>

    <input 
        type="text"
        name="course"
        value="<%= student.course %>"
        required>

    <br><br>



    <label>
        Semester:
    </label>

    <input 
        type="number"
        name="semester"
        min="1"
        max="8"
        value="<%= student.semester %>"
        required>

    <br><br>



    <button type="submit">
        Update Student
    </button>


</form>


<br>

<a href="/students">
    Back to Students
</a>


</body>

</html>