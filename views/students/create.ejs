
<!DOCTYPE html>
<html>

<head>

    <title>Add Student</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

<div class="container py-5">

    <%- include("../partials/messages") %>

    <!-- Hero -->

    <div class="hero d-flex justify-content-between align-items-center flex-wrap">

        <div>

            <h1>➕ Add Student</h1>

            <p>
                Register a new student in the record system.
            </p>

        </div>

        <a
            href="/students"
            class="btn btn-light btn-lg">

            ← Back

        </a>

    </div>

    <!-- Form -->

    <div class="card shadow mx-auto" style="max-width:700px;">

        <div class="card-body p-5">

            <% if (errors.length > 0) { %>

                <div class="alert alert-danger">

                    <ul class="mb-0">

                        <% errors.forEach(error => { %>

                            <li><%= error.msg %></li>

                        <% }) %>

                    </ul>

                </div>

            <% } %>

            <form action="/students" method="POST">

                <!-- Name -->

                <div class="mb-4">

                    <label class="form-label fw-semibold">

                        Name

                    </label>

                    <input
                        class="form-control"
                        type="text"
                        name="name"
                        value="<%= student.name || '' %>"
                        required>

                </div>

                <!-- Email -->

                <div class="mb-4">

                    <label class="form-label fw-semibold">

                        Email

                    </label>

                    <input
                        class="form-control"
                        type="email"
                        name="email"
                        value="<%= student.email || '' %>"
                        required>

                </div>

                <!-- Course -->

                <div class="mb-4">

                    <label class="form-label fw-semibold">

                        Course

                    </label>

                    <select
                        class="form-select"
                        name="course"
                        required>

                        <option value="">
                            Select Course
                        </option>

                        <option value="CSE" <%= student.course === "CSE" ? "selected" : "" %>>
                            CSE
                        </option>

                        <option value="ECE" <%= student.course === "ECE" ? "selected" : "" %>>
                            ECE
                        </option>

                        <option value="ME" <%= student.course === "ME" ? "selected" : "" %>>
                            ME
                        </option>

                        <option value="CE" <%= student.course === "CE" ? "selected" : "" %>>
                            CE
                        </option>

                    </select>

                </div>

                <!-- Semester -->

                <div class="mb-5">

                    <label class="form-label fw-semibold">

                        Semester

                    </label>

                    <input
                        class="form-control"
                        type="number"
                        name="semester"
                        min="1"
                        max="8"
                        value="<%= student.semester || '' %>"
                        required>

                </div>

                <!-- Buttons -->

                <div class="d-grid gap-3">

                    <button
                        class="btn btn-primary btn-lg"
                        type="submit">

                        ➕ Add Student

                    </button>

                    <a
                        href="/students"
                        class="btn btn-outline-secondary">

                        ← Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>
