<!DOCTYPE html>
<html>
<head>
    <title>Add Student</title>
</head>

<body>

<h1>Add Student</h1>

<form action="/students" method="POST">

    <label>Name:</label>
    <input type="text" name="name">
    <br><br>

    <label>Email:</label>
    <input type="email" name="email">
    <br><br>

    <label>Course:</label>
    <input type="text" name="course">
    <br><br>

    <label>Semester:</label>
    <input 
    type="number" 
    name="semester"
    min="1"
    max="8">
    <br><br>

    <button type="submit">
        Add Student
    </button>

</form>

</body>
</html>
